+   the data files of vkxp-ruby-sys, has the number it has there at start-up.
+   Until the host marks the start of the game's scripts, any other name is
+   numbered from a provisional counter far above the table; from the mark
+   on, new names continue the original's sequence in last_id, and the first
+   rb_intern of a provisional name advances that sequence once and keeps the
+   name's number. */
+#include "vkxp_symbol_table.h"
+
+#define VKXP_FIRST_PROVISIONAL ((ID)1 << 24)
