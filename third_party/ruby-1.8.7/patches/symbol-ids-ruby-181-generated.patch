+static const struct vkxp_symbol_table *symbol_table = &vkxp_symbol_tables[0];
+static ID last_id = VKXP_LAST_MEASURED_DEFAULT;
+static ID provisional_id = VKXP_FIRST_PROVISIONAL - 1;
+static char *provisional_seen;
+static ID provisional_capa;
+static int scripts_marked;
+static int symbols_numbered;
+
+void
+ruby_vkxp_mark_game_scripts()
+{
+    scripts_marked = 1;
+}
+
+/* Selects the measured table by its index in vkxp_symbol_tables, 0 without
+   a call.  Only before ruby_init, which interns names. */
+void
+ruby_vkxp_select_symbols(table)
+    int table;
+{
+    if (symbols_numbered) {
+	rb_bug("vkxp symbol table: selected after a name was interned");
+    }
+    if (table < 0 ||
+	table >= (int)(sizeof(vkxp_symbol_tables) / sizeof(vkxp_symbol_tables[0]))) {
+	rb_bug("vkxp symbol table: there is no table %d", table);
+    }
+    symbol_table = &vkxp_symbol_tables[table];
+    last_id = symbol_table->last;
+}
+
+static ID
+vkxp_measured_id(name)
+    const char *name;
+{
+    int low = 0;
+    int high = symbol_table->length;
+
+    while (low < high) {
+	int mid = (low + high) / 2;
+	int order = strcmp(name, symbol_table->symbols[mid].name);
+
+	if (order == 0) return symbol_table->symbols[mid].id;
+	if (order < 0) high = mid;
+	else low = mid + 1;
+    }
+    return 0;
+}
+
+/* The next counter value for a name outside the table; `named' is zero for
+   the parser's internal identifiers, which no rb_intern finds again. */
+static ID
+vkxp_next_counter(named)
+    int named;
+{
+    ID n;
+
+    if (scripts_marked) {
+	if (last_id >= VKXP_FIRST_PROVISIONAL - 1) {
+	    rb_raise(rb_eRuntimeError, "symbol table overflow");
+	}
+	return ++last_id;
+    }
+    n = provisional_id - (VKXP_FIRST_PROVISIONAL - 1);
+    if (n >= provisional_capa) {
+	ID capa = provisional_capa ? provisional_capa * 2 : 1024;
+
+	REALLOC_N(provisional_seen, char, capa);
+	MEMZERO(provisional_seen + provisional_capa, char, capa - provisional_capa);
+	provisional_capa = capa;
+    }
+    provisional_seen[n] = !named;
+    return ++provisional_id;
+}
 
